<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      The CLI ships as NativeAOT single-file binaries, so every project in the tree is analysed
      for trim/AOT safety at build time rather than at publish time, when a violation is far more
      expensive to discover. This is what keeps reflection-based libraries out by construction.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>

    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!--
      This CLI still implements spec 0.19 and builds against the 0.19 SDK packages, while the SDK
      source beside it in the monorepo is at 0.20. Remove this line when the CLI adopts 0.20; see
      Directory.Build.targets.
    -->
    <UseUtosSdkSource>false</UseUtosSdkSource>
  </PropertyGroup>

</Project>
