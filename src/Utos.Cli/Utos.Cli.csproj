<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Utos.Cli</RootNamespace>
    <AssemblyName>utos</AssemblyName>

    <!-- Shipped as a NativeAOT single-file binary; see .github/workflows/release.yml. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      Symbols go to a separate file rather than into the binary. No-op on Windows, but it roughly
      halves the Linux and macOS binaries, and the released archive ships only the executable.
    -->
    <StripSymbols>true</StripSymbols>

    <!-- Surfaced by `utos version`; the release pipeline overrides it with -p:Version=. -->
    <Version>0.1.0-dev</Version>
    <!-- Report the version on its own, rather than appending the commit sha to it. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Utos.Cli.Core\Utos.Cli.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

</Project>
